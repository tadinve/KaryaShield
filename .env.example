# LLM_PROVIDER=vertex uses Gemini on Vertex AI (ADC locally; service account in containers)
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# LLM_PROVIDER=openai_compat uses any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace_me
CLICKHOUSE_DATABASE=karyashield
CLICKHOUSE_SECURE=true
GITHUB_REPO=OWNER/karyashield-demo-target
GITHUB_BRANCH=main
DEMO_REPO_ALLOWLIST=OWNER/karyashield-demo-target
KARYASHIELD_ENABLE_WRITES=false
KARYASHIELD_MIN_SEVERITY=WARNING
WORKSPACE_DIR=.workspaces
SCAN_TIMEOUT_SECONDS=90
LLM_TIMEOUT_SECONDS=45
WATCH_INTERVAL_SECONDS=120
# Akash Console API key (managed wallet) for deploy/akash_deploy.py
AKASH_API_KEY=replace_me
